---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section id="galeria" class="scroll-mt-24 border-y border-white/5 bg-night-900/40 py-16 sm:py-24">
  <div class="container-moon">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Universo visual</p>
      <h2 class="section-title mt-3">Escenas de Triria</h2>
      <p class="mt-4 text-silver-300">
        Fragmentos visuales del mundo. Las fotos nuevas en el manifiesto aparecen solas en el carrusel.
      </p>
    </div>

    <div class="reveal reveal-delay-1 relative mx-auto mt-10 max-w-4xl">
      <div
        id="scene-carousel"
        class="card-glass relative overflow-hidden rounded-3xl shadow-glow"
        role="region"
        aria-roledescription="carrusel"
        aria-label="Escenas de Triria"
        tabindex="0"
      >
        <div id="scene-viewport" class="relative w-full overflow-hidden">
          <div
            id="scene-track"
            class="flex transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
          ></div>
        </div>

        <button type="button" id="scene-prev" class="absolute left-3 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-night-950/80 text-moon-50 backdrop-blur-md transition hover:border-accent/50 hover:bg-night-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:left-4" aria-label="Escena anterior">
          <svg class="h-5 w-5 pointer-events-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.78 4.22a.75.75 0 0 1 0 1.06L8.06 10l4.72 4.72a.75.75 0 1 1-1.06 1.06l-5.25-5.25a.75.75 0 0 1 0-1.06l5.25-5.25a.75.75 0 0 1 1.06 0z" clip-rule="evenodd" /></svg>
        </button>
        <button type="button" id="scene-next" class="absolute right-3 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-night-950/80 text-moon-50 backdrop-blur-md transition hover:border-accent/50 hover:bg-night-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:right-4" aria-label="Escena siguiente">
          <svg class="h-5 w-5 pointer-events-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.22 4.22a.75.75 0 0 1 1.06 0l5.25 5.25a.75.75 0 0 1 0 1.06l-5.25 5.25a.75.75 0 1 1-1.06-1.06L11.94 10 7.22 5.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" /></svg>
        </button>

        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-night-950 via-night-950/85 to-transparent px-5 pb-5 pt-16 sm:px-8">
          <p id="scene-counter" class="text-xs uppercase tracking-[0.18em] text-accent"></p>
          <h3 id="scene-title" class="mt-1 font-display text-xl text-moon-50 sm:text-2xl"></h3>
          <p id="scene-description" class="mt-1 max-w-2xl text-sm text-silver-300"></p>
        </div>
      </div>

      <div id="scene-dots" class="mt-5 flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label="Indicadores de escena"></div>
      <p id="gallery-status" class="mt-4 text-center text-sm text-silver-400">Cargando escenas...</p>
    </div>
  </div>
</section>

<dialog id="scene-lightbox" class="max-h-[92vh] max-w-[92vw] overflow-hidden rounded-2xl border border-white/10 bg-night-950 p-0 text-silver-100 shadow-glow-lg backdrop:bg-night-950/90">
  <button id="scene-lightbox-close" type="button" class="absolute right-3 top-3 z-10 rounded-full border border-white/10 bg-night-950/80 px-3 py-2 text-sm text-white backdrop-blur-sm" aria-label="Cerrar imagen">Cerrar</button>
  <figure class="m-0">
    <img id="scene-lightbox-image" src="" alt="" class="max-h-[78vh] max-w-[92vw] object-contain" />
    <figcaption id="scene-lightbox-caption" class="px-5 py-4 text-center font-display text-lg text-moon-50"></figcaption>
  </figure>
</dialog>

<script define:vars={{ manifestUrl: `${base}images/scenes/scenes.json`, imageBaseUrl: `${base}images/scenes/` }}>
  const viewport = document.querySelector('#scene-viewport');
  const track = document.querySelector('#scene-track');
  const carousel = document.querySelector('#scene-carousel');
  const status = document.querySelector('#gallery-status');
  const dotsRoot = document.querySelector('#scene-dots');
  const titleEl = document.querySelector('#scene-title');
  const descEl = document.querySelector('#scene-description');
  const counterEl = document.querySelector('#scene-counter');
  const prevBtn = document.querySelector('#scene-prev');
  const nextBtn = document.querySelector('#scene-next');
  const lightbox = document.querySelector('#scene-lightbox');
  const lightboxImage = document.querySelector('#scene-lightbox-image');
  const lightboxCaption = document.querySelector('#scene-lightbox-caption');
  const closeButton = document.querySelector('#scene-lightbox-close');

  let scenes = [];
  let index = 0;
  let autoplayId = 0;
  const AUTOPLAY_MS = 4500;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const openLightbox = (scene) => {
    if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement)) return;
    lightboxImage.src = scene.src;
    lightboxImage.alt = scene.alt || scene.title || 'Escena de Triria';
    if (lightboxCaption) lightboxCaption.textContent = scene.title || '';
    pauseAutoplay();
    lightbox.showModal();
  };

  closeButton?.addEventListener('click', () => { if (lightbox instanceof HTMLDialogElement) lightbox.close(); });
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close(); });
  lightbox?.addEventListener('close', () => resumeAutoplay());

  const updateChrome = () => {
    const scene = scenes[index];
    if (!scene || !(track instanceof HTMLElement)) return;
    track.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
    if (counterEl) counterEl.textContent = `${index + 1} / ${scenes.length}`;
    if (titleEl) titleEl.textContent = scene.title || 'Escena de Triria';
    if (descEl) descEl.textContent = scene.description || '';
    dotsRoot?.querySelectorAll('button').forEach((dot, i) => {
      const active = i === index;
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
      dot.classList.toggle('bg-accent', active);
      dot.classList.toggle('scale-125', active);
      dot.classList.toggle('bg-white/25', !active);
    });
  };

  const goTo = (nextIndex) => {
    if (!scenes.length) return;
    index = ((nextIndex % scenes.length) + scenes.length) % scenes.length;
    updateChrome();
  };
  const next = () => goTo(index + 1);
  const prev = () => goTo(index - 1);

  const pauseAutoplay = () => { if (autoplayId) { window.clearInterval(autoplayId); autoplayId = 0; } };
  const resumeAutoplay = () => {
    if (reduceMotion || scenes.length <= 1) return;
    pauseAutoplay();
    autoplayId = window.setInterval(next, AUTOPLAY_MS);
  };

  prevBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); prev(); resumeAutoplay(); });
  nextBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); next(); resumeAutoplay(); });

  carousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); prev(); resumeAutoplay(); }
    else if (event.key === 'ArrowRight') { event.preventDefault(); next(); resumeAutoplay(); }
  });

  let pointerStartX = 0, pointerDeltaX = 0, isPointerDown = false;
  viewport?.addEventListener('pointerdown', (event) => {
    if (!(event instanceof PointerEvent)) return;
    if (event.target instanceof Element && event.target.closest('button')) return;
    isPointerDown = true; pointerStartX = event.clientX; pointerDeltaX = 0; pauseAutoplay();
  });
  viewport?.addEventListener('pointermove', (event) => {
    if (!isPointerDown || !(event instanceof PointerEvent)) return;
    pointerDeltaX = event.clientX - pointerStartX;
  });
  const onPointerUp = () => {
    if (!isPointerDown) return;
    isPointerDown = false;
    if (Math.abs(pointerDeltaX) > 40) { if (pointerDeltaX < 0) next(); else prev(); }
    resumeAutoplay();
  };
  viewport?.addEventListener('pointerup', onPointerUp);
  viewport?.addEventListener('pointercancel', onPointerUp);

  carousel?.addEventListener('mouseenter', pauseAutoplay);
  carousel?.addEventListener('mouseleave', resumeAutoplay);

  const buildSlides = () => {
    if (!(track instanceof HTMLElement) || !(dotsRoot instanceof HTMLElement)) return;
    track.innerHTML = '';
    dotsRoot.innerHTML = '';
    scenes.forEach((scene, i) => {
      const slide = document.createElement('div');
      slide.className = 'relative min-w-full w-full shrink-0 grow-0 basis-full';
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'slide');
      slide.setAttribute('aria-label', `${i + 1} de ${scenes.length}`);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'block w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-accent';
      button.setAttribute('aria-label', `Ampliar ${scene.title || 'escena'}`);

      const img = document.createElement('img');
      img.src = scene.src;
      img.alt = scene.alt || scene.title || 'Escena de Triria';
      img.loading = i === 0 ? 'eager' : 'lazy';
      img.decoding = 'async';
      img.draggable = false;
      img.className = 'aspect-[16/10] w-full object-cover sm:aspect-[16/9] select-none';

      button.append(img);
      button.addEventListener('click', () => openLightbox(scene));
      slide.append(button);
      track.append(slide);

      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('role', 'tab');
      dot.className = 'h-2.5 w-2.5 rounded-full bg-white/25 transition hover:bg-accent/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
      dot.setAttribute('aria-label', `Ir a escena ${i + 1}`);
      dot.addEventListener('click', () => { goTo(i); resumeAutoplay(); });
      dotsRoot.append(dot);
    });
  };

  const loadGallery = async () => {
    if (!status) return;
    try {
      const response = await fetch(manifestUrl, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Manifiesto: ${response.status}`);
      const data = await response.json();
      if (!Array.isArray(data) || data.length === 0) { status.textContent = 'Aún no hay escenas publicadas.'; return; }
      scenes = data.filter((item) => item && typeof item.file === 'string' && item.file.length > 0).map((item) => ({ ...item, src: `${imageBaseUrl}${encodeURIComponent(item.file)}` }));
      if (!scenes.length) { status.textContent = 'Aún no hay escenas publicadas.'; return; }
      status.hidden = true;
      buildSlides();
      goTo(0);
      resumeAutoplay();
    } catch (error) {
      console.error(error);
      status.textContent = 'No se pudo cargar la galería.';
    }
  };

  loadGallery();
</script>
