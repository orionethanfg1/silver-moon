---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const links = [
  { href: '#sinopsis', label: 'Sinopsis' },
  { href: '#mundo', label: 'Triria' },
  { href: '#personajes', label: 'Personajes' },
  { href: '#trailer', label: 'Tráiler' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-night-950/70 backdrop-blur-xl">
  <div class="container-moon flex h-16 items-center justify-between gap-4">
    <a href={`${base}`} class="group flex min-w-0 items-center gap-3">
      <img
        src={`${base}icons/cat_moon_icon_cutout.png`}
        alt=""
        class="h-9 w-9 shrink-0 object-contain"
        width="36"
        height="36"
      />
      <span class="truncate font-display text-base font-semibold tracking-wide text-moon-50 sm:text-lg">
        The Cat and the Silver Moon
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-silver-300 transition hover:text-accent">
          {l.label}
        </a>
      ))}
    </nav>

    <a href="#contacto" class="btn-primary !px-4 !py-2 text-xs sm:text-sm">
      Lista de espera
    </a>
  </div>
</header>
