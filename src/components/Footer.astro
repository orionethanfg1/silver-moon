---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-10">
  <div class="container-moon flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <div>
      <p class="font-display text-lg text-moon-100">The Cat and the Silver Moon</p>
      <p class="mt-1 text-sm text-silver-400">Volumen I: Un mundo nuevo · © {year} Nahum F.G.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-silver-400 sm:justify-end">
      <div class="flex items-center gap-2">
        <span>Visitas</span>
        <span
          id="visit-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >…</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Vistas del tráiler</span>
        <span
          id="video-view-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >…</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const GC = 'https://nahumfg.goatcounter.com';

  const formatCount = (value) => {
    const n = Number(String(value).replace(/[^\d]/g, ''));
    if (!Number.isFinite(n)) return '—';
    return n.toLocaleString('es-MX');
  };

  const fetchCount = async (path) => {
    const url = `${GC}/counter/${encodeURIComponent(path)}.json`;
    const res = await fetch(url, { mode: 'cors', credentials: 'omit' });
    if (!res.ok) throw new Error(String(res.status));
    const data = await res.json();
    return data.count ?? data.count_unique ?? 0;
  };

  const setText = (id, value) => {
    const el = document.querySelector(id);
    if (el) el.textContent = formatCount(value);
  };

  const load = async () => {
    const pageCandidates = ['/silver-moon/', '/silver-moon', '/', location.pathname];
    const videoCandidates = ['/video/promo', '/silver-moon/video/promo'];

    let pageCount = null;
    for (const path of pageCandidates) {
      try {
        pageCount = await fetchCount(path);
        if (pageCount !== null && pageCount !== undefined) break;
      } catch (_) {}
    }

    let videoCount = null;
    for (const path of videoCandidates) {
      try {
        videoCount = await fetchCount(path);
        if (videoCount !== null && videoCount !== undefined) break;
      } catch (_) {}
    }

    setText('#visit-count', pageCount ?? '—');
    setText('#video-view-count', videoCount ?? '—');
  };

  load().catch(() => {
    setText('#visit-count', '—');
    setText('#video-view-count', '—');
  });
</script>
