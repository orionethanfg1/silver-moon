---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-10">
  <div class="container-moon flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <div>
      <p class="font-display text-lg text-moon-100">The Cat and the Silver Moon</p>
      <p class="mt-1 text-sm text-silver-400">Volumen I: Un mundo nuevo · © {year} Nahum F.G.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-silver-400 sm:justify-end">
      <div class="flex items-center gap-2">
        <span>Visitas</span>
        <span
          id="visit-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >—</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Vistas del tráiler</span>
        <span
          id="video-view-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >—</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const tryCounters = () => {
    const gc = window.goatcounter;
    if (!gc || !gc.visit_count) return false;

    const mount = (selector, path) => {
      const el = document.querySelector(selector);
      if (!(el instanceof HTMLElement)) return;
      el.textContent = '';
      gc.visit_count({
        type: 'html',
        append: selector,
        path,
        no_branding: true,
        attr: {
          style: 'border:0;width:3.5rem;height:1.25rem;overflow:hidden;vertical-align:middle;background:transparent',
        },
      });
    };

    mount('#visit-count', '/');
    mount('#video-view-count', '/video/promo');
    return true;
  };

  if (!tryCounters()) {
    const script = document.querySelector('script[data-goatcounter]');
    script?.addEventListener('load', () => tryCounters(), { once: true });
    let attempts = 0;
    const timer = window.setInterval(() => {
      attempts += 1;
      if (tryCounters() || attempts > 15) window.clearInterval(timer);
    }, 400);
  }
</script>
