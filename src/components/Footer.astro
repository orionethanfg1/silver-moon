---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-10">
  <div class="container-moon flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <div>
      <p class="font-display text-lg text-moon-100">The Cat and the Silver Moon</p>
      <p class="mt-1 text-sm text-silver-400">Volumen I: Un mundo nuevo · © {year} Nahum F.G.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-silver-400 sm:justify-end">
      <div class="flex items-center gap-2">
        <span>Visitas</span>
        <span
          id="visit-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >—</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Vistas del tráiler</span>
        <span
          id="video-view-count"
          class="inline-flex min-h-6 min-w-[3rem] items-center justify-center rounded-md border border-white/10 bg-white/5 px-2 tabular-nums text-moon-100"
          aria-live="polite"
        >—</span>
      </div>
    </div>
  </div>
</footer>

<script>
  /**
   * Paths exactos registrados en GoatCounter (panel nahumfg):
   *   /silver-moon   → visitas de la landing
   *   /video/promo   → evento al reproducir el tráiler
   *
   * Requiere en Settings → "Allow adding visitor counts on your website" = ON
   * (si está OFF, /counter/*.json responde 403 y no se pueden mostrar números).
   */
  const GC = 'https://nahumfg.goatcounter.com';
  const PAGE_PATH = '/silver-moon';
  const VIDEO_PATH = '/video/promo';

  const setText = (id, text) => {
    const el = document.querySelector(id);
    if (el instanceof HTMLElement) el.textContent = text;
  };

  const formatCount = (raw) => {
    if (raw === null || raw === undefined || raw === '') return null;
    const digits = String(raw).replace(/[^\d]/g, '');
    if (!digits) return null;
    const n = Number(digits);
    if (!Number.isFinite(n)) return null;
    return n.toLocaleString('es-MX');
  };

  const fetchCount = async (path) => {
    const url = `${GC}/counter/${encodeURIComponent(path)}.json`;
    const res = await fetch(url, { mode: 'cors', credentials: 'omit' });
    if (!res.ok) throw new Error(`counter ${res.status}`);
    const data = await res.json();
    return formatCount(data.count ?? data.count_unique);
  };

  const tryJsonCounters = async () => {
    // Orden: path canónico del panel, variantes habituales de GitHub Pages
    const pagePaths = [PAGE_PATH, `${PAGE_PATH}/`, location.pathname, '/'];
    const videoPaths = [VIDEO_PATH, 'video/promo'];

    let page = null;
    for (const path of pagePaths) {
      try {
        page = await fetchCount(path);
        if (page !== null) break;
      } catch (_) {}
    }

    let video = null;
    for (const path of videoPaths) {
      try {
        video = await fetchCount(path);
        if (video !== null) break;
      } catch (_) {}
    }

    if (page !== null) setText('#visit-count', page);
    if (video !== null) setText('#video-view-count', video);
    return page !== null || video !== null;
  };

  const tryVisitCountWidget = () => {
    const gc = window.goatcounter;
    if (!gc?.visit_count) return false;

    const mount = (selector, path) => {
      const el = document.querySelector(selector);
      if (!(el instanceof HTMLElement)) return;
      el.textContent = '';
      gc.visit_count({
        type: 'html',
        append: selector,
        path,
        no_branding: true,
        attr: {
          style:
            'border:0;width:3.25rem;height:1.15rem;overflow:hidden;vertical-align:middle;background:transparent;filter:invert(1);',
        },
      });
    };

    mount('#visit-count', PAGE_PATH);
    mount('#video-view-count', VIDEO_PATH);
    return true;
  };

  const boot = async () => {
    try {
      if (await tryJsonCounters()) return;
    } catch (_) {}

    if (tryVisitCountWidget()) return;

    const script = document.querySelector('script[data-goatcounter]');
    script?.addEventListener('load', () => tryVisitCountWidget(), { once: true });

    // Reintento breve por si count.js carga tarde
    let n = 0;
    const t = setInterval(() => {
      n += 1;
      if (tryVisitCountWidget() || n > 20) clearInterval(t);
    }, 300);
  };

  boot();
</script>
