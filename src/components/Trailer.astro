---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section id="trailer" class="scroll-mt-24 py-16 sm:py-24">
  <div class="container-moon">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow">Tráiler oficial</p>
      <h2 class="section-title mt-3">Un primer vistazo a Triria</h2>
      <p class="mt-4 text-silver-300">
        Sesenta segundos de atmósfera, personajes y el tono de la historia.
      </p>
    </div>

    <div class="reveal reveal-delay-1 relative mx-auto mt-10 max-w-4xl">
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-accent/30 via-moon-400/20 to-accent/10 opacity-60 blur-xl"></div>
      <div class="card-glass relative overflow-hidden rounded-3xl shadow-glow">
        <video
          id="promo-video"
          class="aspect-video w-full bg-night-900"
          controls
          playsinline
          preload="metadata"
          poster={`${base}images/poster.jpg`}
        >
          <source src={`${base}videos/promo-web.mp4`} type="video/mp4" />
          Tu navegador no soporta video HTML5.
        </video>
      </div>
      <p class="mt-4 text-center text-sm text-silver-400">
        Video autoalojado · sin YouTube · sin tracking de terceros
      </p>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('#promo-video');
  let trailerViewRecorded = false;

  video?.addEventListener('play', () => {
    if (trailerViewRecorded) return;
    trailerViewRecorded = true;

    window.goatcounter?.count({
      event: true,
      path: '/video/promo',
      title: 'Vistas del tráiler',
      no_session: false,
    });
  });
</script>
