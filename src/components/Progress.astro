---
import progress from '../data/progress.json';

const goal = Math.max(1, Number(progress.pagesGoal) || 1);
const written = Math.max(0, Number(progress.pagesWritten) || 0);
const chapters = Math.max(0, Number(progress.chapters) || 0);
const currentStage = Math.max(1, Number(progress.currentStage) || 1);
const pct = Math.min(100, Math.round((written / goal) * 1000) / 10);
const remaining = Math.max(0, goal - written);
const stages = Array.isArray(progress.stages) ? progress.stages : [];

function barTone(p: number) {
  if (p >= 90) return { bar: 'from-emerald-400 to-accent', glow: 'shadow-[0_0_28px_rgba(52,211,153,0.35)]', label: 'text-emerald-300' };
  if (p >= 70) return { bar: 'from-accent to-sky-300', glow: 'shadow-glow', label: 'text-accent' };
  if (p >= 40) return { bar: 'from-amber-400 to-accent', glow: 'shadow-[0_0_24px_rgba(251,191,36,0.25)]', label: 'text-amber-300' };
  return { bar: 'from-rose-400/90 to-amber-400', glow: '', label: 'text-rose-300' };
}

const tone = barTone(pct);
---

<section id="progreso" class="scroll-mt-24 py-16 sm:py-24">
  <div class="container-moon">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Camino hacia la publicación</p>
      <h2 class="section-title mt-3">Progreso del proyecto</h2>
      <p class="mt-4 text-silver-300">
        El Volumen I avanza por etapas. Ahora estamos en la escritura del manuscrito.
      </p>
    </div>

    <ol class="reveal reveal-delay-1 mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
      {stages.map((stage) => {
        const active = stage.id === currentStage;
        const done = stage.id < currentStage;
        return (
          <li
            class:list={[
              'relative rounded-2xl border p-5 transition',
              active
                ? 'border-accent/50 bg-accent/10 shadow-glow'
                : done
                  ? 'border-emerald-400/30 bg-emerald-400/5'
                  : 'border-white/10 bg-white/[0.03]',
            ]}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold',
                  active ? 'bg-accent text-night-950' : done ? 'bg-emerald-400/90 text-night-950' : 'bg-white/10 text-silver-300',
                ]}
              >
                {done ? '✓' : stage.id}
              </span>
              <div>
                <p class="text-[10px] uppercase tracking-[0.16em] text-silver-400">Etapa {stage.id}</p>
                <h3 class="font-display text-lg text-moon-50">{stage.title}</h3>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-silver-300">{stage.description}</p>
            {active && <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-accent">En curso</p>}
            {done && <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-emerald-300">Completada</p>}
            {!active && !done && <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-silver-500">Próximamente</p>}
          </li>
        );
      })}
    </ol>

    <div class="reveal reveal-delay-2 mx-auto mt-10 max-w-3xl card-glass p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-silver-400">Etapa 1 · Escritura</p>
          <p class={`mt-1 font-display text-4xl font-semibold tabular-nums ${tone.label}`} id="progress-pct-label">0%</p>
        </div>
        <p class="text-sm text-silver-400">
          {written.toLocaleString('es-MX')} / {goal.toLocaleString('es-MX')} páginas
        </p>
      </div>

      <div
        class="mt-5 h-3.5 overflow-hidden rounded-full bg-white/10"
        role="progressbar"
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow={pct}
        aria-label={`Progreso de escritura: ${pct} por ciento`}
      >
        <div
          id="progress-bar-fill"
          class={`h-full w-0 rounded-full bg-gradient-to-r ${tone.bar} ${tone.glow}`}
          data-target={pct}
          style="transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);"
        ></div>
      </div>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-center sm:text-left">
          <dt class="text-xs uppercase tracking-wider text-silver-400">Objetivo</dt>
          <dd class="mt-1 font-display text-2xl text-moon-50 tabular-nums">{goal.toLocaleString('es-MX')}</dd>
          <p class="mt-1 text-xs text-silver-500">páginas meta</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-center sm:text-left">
          <dt class="text-xs uppercase tracking-wider text-silver-400">Escritas</dt>
          <dd class="mt-1 font-display text-2xl text-moon-50 tabular-nums">{written.toLocaleString('es-MX')}</dd>
          <p class="mt-1 text-xs text-silver-500">≈ {remaining.toLocaleString('es-MX')} por completar</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-center sm:text-left">
          <dt class="text-xs uppercase tracking-wider text-silver-400">Capítulos</dt>
          <dd class="mt-1 font-display text-2xl text-moon-50 tabular-nums">{chapters}</dd>
          <p class="mt-1 text-xs text-silver-500">+ prólogo</p>
        </div>
      </dl>

      {progress.note && <p class="mt-6 text-center text-xs text-silver-500">{progress.note}</p>}
    </div>
  </div>
</section>

<script>
  const fill = document.querySelector('#progress-bar-fill');
  const label = document.querySelector('#progress-pct-label');
  const target = Number(fill?.getAttribute('data-target') || 0);

  const animate = () => {
    if (!(fill instanceof HTMLElement)) return;
    requestAnimationFrame(() => {
      fill.style.width = `${target}%`;
    });
    if (label) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        label.textContent = `${target}%`;
        return;
      }
      const start = performance.now();
      const duration = 1100;
      const tick = (now) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        const val = target * eased;
        label.textContent = `${val % 1 === 0 ? val.toFixed(0) : val.toFixed(1)}%`;
        if (t < 1) requestAnimationFrame(tick);
        else label.textContent = `${target}%`;
      };
      requestAnimationFrame(tick);
    }
  };

  if (fill && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate();
            io.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(fill);
  } else {
    animate();
  }
</script>
