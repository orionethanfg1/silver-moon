---
const characters = [
  {
    name: 'Nahum',
    role: 'Protagonista',
    blurb: 'Despierta en Triria sin entender del todo por qué. Descubrir su poder es solo el inicio de una responsabilidad mayor.',
  },
  {
    name: 'Irish',
    role: 'La pantera',
    blurb: 'Enigmática y ligada al destino de Nahum. Guía, sombra y presencia que no se explica del todo de una sola vez.',
  },
  {
    name: 'Ivanna',
    role: 'Compañera de camino',
    blurb: 'Su llegada cambia la vida de Nahum. Fuerza, sensibilidad y un vínculo que se pone a prueba en un mundo nuevo.',
  },
  {
    name: 'Niamh',
    role: 'Presencia clave',
    blurb: 'Parte del tejido social y emocional de Triria. Elegancia, misterio y un lugar propio en la historia.',
  },
  {
    name: 'Cirse',
    role: 'Figura del mundo',
    blurb: 'Una de las presencias que dan profundidad a las cortes, alianzas y tensiones de Triria.',
  },
];
---

<section id="personajes" class="scroll-mt-24 py-16 sm:py-24">
  <div class="container-moon">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Elenco</p>
        <h2 class="section-title mt-3">Personajes</h2>
      </div>
      <p class="max-w-md text-sm text-silver-300 sm:text-base">
        Pasa el cursor o toca cada tarjeta. Sin spoilers: solo el aroma de quién habita esta historia.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {characters.map((c, i) => (
        <button
          type="button"
          class={`reveal reveal-delay-${(i % 4) + 1} group card-glass relative overflow-hidden p-6 text-left transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-glow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent`}
          data-character={c.name}
          aria-expanded="false"
        >
          <div class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full bg-accent/10 opacity-0 blur-2xl transition group-hover:opacity-100"></div>
          <p class="text-xs uppercase tracking-[0.16em] text-accent">{c.role}</p>
          <h3 class="mt-2 font-display text-2xl text-moon-50">{c.name}</h3>
          <p class="mt-3 text-sm leading-relaxed text-silver-300">{c.blurb}</p>
        </button>
      ))}
    </div>
  </div>
</section>
